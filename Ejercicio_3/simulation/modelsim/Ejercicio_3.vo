// iD	=>  Location: PIN_U13,	 I/O Standard: 2.5 V,	 Current Strength: Default
// icontrol	=>  Location: PIN_V13,	 I/O Standard: 2.5 V,	 Current Strength: Default


wire gnd;
wire vcc;
wire unknown;

assign gnd = 1'b0;
assign vcc = 1'b1;
assign unknown = 1'bx;

tri1 devclrn;
tri1 devpor;
tri1 devoe;
wire \~QUARTUS_CREATED_GND~I_combout ;
wire \iD~input_o ;
wire \icontrol~input_o ;
